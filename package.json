{
  "name": "avari",
  "private": true,
  "version": "1.6.1",
  "workspaces": [
    "apps/web",
    "apps/extension",
    "packages/shared"
  ],
  "scripts": {
    "dev": "npm run dev -w @avari/web",
    "dev:extension": "npm run dev -w @avari/extension",
    "dev:all": "concurrently -n \"api,web,ext\" -c \"blue,green,magenta\" \"make api\" \"npm run dev\" \"npm run dev:extension\"",
    "build:web": "npm run build -w @avari/web && node scripts/embed-web.mjs",
    "build:extension": "npm run build -w @avari/extension",
    "build": "npm run build:extension && node scripts/package-extension.mjs && npm run build:web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "AVARI_E2E=1 go test ./apps/server/internal/httpapi -run \"^TestBrowser$\" -count=1 -timeout 10m",
    "generate:api": "node scripts/openapi.mjs && openapi-typescript docs/openapi.json -o packages/shared/src/generated-api.ts",
    "desktop:prepare": "npm run build && node scripts/desktop.mjs",
    "desktop:dev": "npm run desktop:prepare && cd apps/desktop && tauri dev",
    "desktop:build": "npm run desktop:prepare && cd apps/desktop && tauri build --config src-tauri/binaries/release-config.json",
    "test:pages": "playwright test --config playwright.pages.config.ts",
    "test:releases": "node --test scripts/releases.test.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tauri-apps/cli": "^2.12.2",
    "@types/chrome": "^0.1.24",
    "@types/node": "^26.6.5",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^10.0.6",
    "fflate": "^0.8.3",
    "jsdom": "^27.0.0",
    "openapi-typescript": "^7.10.1",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.2",
    "lucide-react": "^0.544.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
