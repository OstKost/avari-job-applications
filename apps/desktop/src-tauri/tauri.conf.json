{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Avari.Jobs",
  "version": "1.3.0",
  "identifier": "dev.avari.jobs.local",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "launcher",
        "title": "Avari.Jobs \u2014 \u043b\u043e\u043a\u0430\u043b\u044c\u043d\u044b\u0439 \u0441\u0435\u0440\u0432\u0438\u0441",
        "width": 640,
        "height": 520,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/avari-server"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": [
          "Russian",
          "English"
        ]
      }
    },
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU2ODM3MzhFRjM3M0REOUUKUldTZTNYUHpqbk9ENW9kL1JJaWZPQUVVMWVzM0toaHVEZjh5S2Zva08zbnpZWXZkTTdQaHgwMEEK",
      "endpoints": [
        "https://github.com/OstKost/avari-job-applications/releases/latest/download/desktop-update.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
