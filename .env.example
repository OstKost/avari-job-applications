# Local Compose: docker compose up --build -d app
AVARI_ORIGIN=http://localhost:47831
# Production: set a real domain and matching HTTPS origin, then use --profile https.
AVARI_DOMAIN=avari.example.com
# Set true only behind the bundled reverse proxy, with the backend port on loopback.
AVARI_TRUST_PROXY=false
# Optional Google Analytics 4 Measurement ID (e.g. G-HWYGMZR8ZY)
VITE_GA_MEASUREMENT_ID=
