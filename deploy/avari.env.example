AVARI_ADDR=127.0.0.1:8080
AVARI_DB=/var/lib/avari/avari.db
AVARI_BACKUPS=/var/lib/avari/backups
AVARI_ORIGIN=https://avari.example.com
AVARI_TRUST_PROXY=true
AVARI_LOG_LEVEL=info
SOURCE_TOKEN=3heNieTssVcsmPcEG8rd3ZWt
INGESTING_HOST=s2800631.us-west-2a.betterstackdata.com
# Optional Web Push (VAPID) settings for PWA push notifications.
# Leave all empty to disable push. To enable, configure all three variables.
AVARI_VAPID_PUBLIC_KEY=
AVARI_VAPID_PRIVATE_KEY=
AVARI_VAPID_CONTACT=

# Telegram is production-only and disabled until acceptance with a separate test bot.
AVARI_TELEGRAM_ENABLED=false
AVARI_TELEGRAM_BOT_TOKEN=
AVARI_TELEGRAM_BOT_USERNAME=
AVARI_TELEGRAM_WEBHOOK_SECRET=

# Optional fallback if Telegram cannot reach the VPS HTTPS ingress.
AVARI_TELEGRAM_DELIVERY_MODE=webhook
