[Unit]
Description=Avari.Jobs job applications
After=network.target
[Service]
Type=simple
User=avari
Group=avari
WorkingDirectory=/var/lib/avari
EnvironmentFile=/etc/avari/avari.env
ExecStart=/opt/avari/avari
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/avari
[Install]
WantedBy=multi-user.target
